# Authentication Configuration
# IMPORTANT: Never commit .env file to version control
# Copy this file to .env.local and set your actual credentials

# Authentication credentials (for production, use a proper authentication system)
AUTH_USERNAME=your_username_here
AUTH_PASSWORD=your_password_here

# Node Environment
NODE_ENV=development

# Security Note:
# In production, you should:
# 1. Use a proper authentication system (e.g., NextAuth.js, Auth0, Clerk)
# 2. Store passwords as bcrypt hashes, never in plain text
# 3. Use secure session management with JWT or similar
# 4. Enable HTTPS/SSL certificates
# 5. Use environment-specific secrets management (e.g., AWS Secrets Manager, Vault)
